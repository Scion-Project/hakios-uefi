diff --git a/drivers/usb/gadget/f_fastboot.c b/drivers/usb/gadget/f_fastboot.c
index 8df0e3f3..54b1afb1 100644
--- a/drivers/usb/gadget/f_fastboot.c
+++ b/drivers/usb/gadget/f_fastboot.c
@@ -398,7 +398,12 @@ static int fastboot_add(struct usb_configuration *c)
 }
 DECLARE_GADGET_BIND_CALLBACK(usb_dnl_fastboot, fastboot_add);
 
-static int fastboot_tx_write(const char *buffer, unsigned int buffer_size)
+/*
+ * @in_flight: the IN request may still be queued (a response that overtakes the last one). From the request's own
+ * completion it is not: a dequeue there makes DWC3 print an error, which "oem console" then sends as the next line,
+ * which completes with another error, and so on for ever.
+ */
+static int __fastboot_tx_write(const char *buffer, unsigned int buffer_size, bool in_flight)
 {
 	struct usb_request *in_req = fastboot_func->in_req;
 	int ret;
@@ -406,7 +411,8 @@ static int fastboot_tx_write(const char *buffer, unsigned int buffer_size)
 	memcpy(in_req->buf, buffer, buffer_size);
 	in_req->length = buffer_size;
 
-	usb_ep_dequeue(fastboot_func->in_ep, in_req);
+	if (in_flight)
+		usb_ep_dequeue(fastboot_func->in_ep, in_req);
 
 	ret = usb_ep_queue(fastboot_func->in_ep, in_req, 0);
 	if (ret)
@@ -414,6 +420,11 @@ static int fastboot_tx_write(const char *buffer, unsigned int buffer_size)
 	return 0;
 }
 
+static int fastboot_tx_write(const char *buffer, unsigned int buffer_size)
+{
+	return __fastboot_tx_write(buffer, buffer_size, true);
+}
+
 static int fastboot_tx_write_str(const char *buffer)
 {
 	return fastboot_tx_write(buffer, strlen(buffer));
@@ -506,7 +517,7 @@ static void multiresponse_on_complete(struct usb_ep *ep, struct usb_request *req
 
 	/* Call handler to obtain next response */
 	fastboot_multiresponse(multiresponse_cmd, response);
-	fastboot_tx_write_str(response);
+	__fastboot_tx_write(response, strlen(response), false);
 
 	/* If response is final OKAY/FAIL response disconnect this handler and unset cmd */
 	if (!strncmp("OKAY", response, 4) || !strncmp("FAIL", response, 4)) {
